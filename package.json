{
  "name": "pip",
  "productName": "Pip",
  "version": "1.0.1",
  "description": "Kisiwa cha bure na open source kwa Windows kinachokuonyesha ma-agent wako wa AI wanafanya nini. A free, open-source status island for Windows.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "BANG DIGITAL LTD",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --win dir --x64 --publish never && makensis build/pip.nsi",
    "dist:win": "node tools/stamp.js && electron-builder --win dir --x64 --publish never -c.win.signAndEditExecutable=true && makensis build/pip.nsi",
    "dist:mac": "node tools/stamp.js && electron-builder --mac dmg --universal --publish never"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tz.co.bang.pip",
    "productName": "Pip",
    "afterPack": "build/after-pack.cjs",
    "extraMetadata": {
      "description": "Pip"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE"
    ],
    "asarUnpack": [
      "src/helpers/**",
      "src/hooks/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/pip.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Pip-${version}-mac.${ext}",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Pip shows what Spotify or Music is playing and lets you control it from the island."
      }
    },
    "dmg": {
      "title": "Pip ${version}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mkumbwajr/pip.git"
  },
  "homepage": "https://github.com/mkumbwajr/pip"
}
