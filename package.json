{
  "name": "pip",
  "productName": "Pip",
  "version": "0.5.0",
  "description": "Kisiwa cha bure na open source kwa Windows kinachokuonyesha ma-agent wako wa AI wanafanya nini. A free, open-source status island for Windows.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "BANG DIGITAL LTD",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --win dir --x64 --publish never && makensis build/pip.nsi",
    "dist:win": "electron-builder --win dir --x64 --publish never -c.win.signAndEditExecutable=true && makensis build/pip.nsi"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tz.co.bang.pip",
    "productName": "Pip",
    "extraMetadata": { "description": "Pip" },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE"
    ],
    "asarUnpack": [
      "src/helpers/**",
      "src/hooks/**"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/pip.ico",
      "signAndEditExecutable": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mkumbwajr/pip.git"
  },
  "homepage": "https://github.com/mkumbwajr/pip"
}
